{
  "name": "openchrome-mcp",
  "version": "1.13.0",
  "description": "Open-source browser automation MCP server. Control your real Chrome from any AI agent.",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./server": {
      "import": "./dist/core/server.js",
      "require": "./dist/core/server.js"
    },
    "./lifecycle": {
      "import": "./dist/core/lifecycle/index.js",
      "require": "./dist/core/lifecycle/index.js"
    }
  },
  "bin": {
    "openchrome": "./dist/cli/index.js",
    "oc": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cli.json && tsc -p tsconfig.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:src": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.cli.json --watch",
    "start": "node dist/index.js serve",
    "check": "node dist/index.js check",
    "test": "jest",
    "test:e2e": "node --expose-gc node_modules/.bin/jest --config tests/e2e/jest.e2e.config.js",
    "test:e2e:smoke": "node --expose-gc node_modules/.bin/jest --config tests/e2e/jest.e2e-smoke.config.js",
    "test:e2e:functional:stdio": "node --expose-gc node_modules/.bin/jest --config tests/e2e/jest.e2e-functional-stdio.config.js",
    "test:e2e:functional:http": "node --expose-gc node_modules/.bin/jest --config tests/e2e/jest.e2e-functional-http.config.js",
    "test:e2e:marathon": "node --expose-gc node_modules/.bin/jest --config tests/e2e/jest.e2e-marathon.config.js",
    "test:e2e:memory-stability": "node --expose-gc node_modules/.bin/jest --config tests/e2e/jest.e2e-memory-stability.config.js",
    "test:e2e:endurance": "ts-node tests/e2e/endurance-runner.ts",
    "test:e2e:external": "node --expose-gc node_modules/.bin/jest --config tests/e2e/jest.e2e-external.config.js",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:repo-structure": "node scripts/lint-repo-structure.mjs",
    "lint:tier": "depcruise --config .dependency-cruiser.cjs src",
    "lint:tool-schemas": "node dist/index.js serve --introspect-tools-list | node scripts/lint-tool-schemas.mjs -",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "harness:parallel-smoke": "ts-node tests/harness/parallel-smoke.ts",
    "harness:frontier": "ts-node tests/harness/frontier-acceptance.ts",
    "harness:decision-fixture": "ts-node tests/harness/decision-fixture.ts",
    "harness:decision-baseline": "ts-node tests/harness/decision-baseline.ts",
    "eval:decisions": "ts-node scripts/eval-decisions.ts",
    "learning": "node dist/index.js learning",
    "harness:certify": "ts-node tests/harness/certification/run-certification.ts",
    "harness:evaluate-candidates": "ts-node tests/harness/candidates/evaluator.ts",
    "docs:capability-map": "ts-node scripts/gen-capability-map.ts",
    "docs:capability-map:check": "ts-node scripts/gen-capability-map.ts --check",
    "evidence:g1": "ts-node scripts/decisions/g1-evidence.ts",
    "evidence:g2": "ts-node scripts/decisions/g2-truncation-report.ts",
    "evidence:g3": "ts-node scripts/decisions/g3-view-eval.ts",
    "thresholds:g3": "ts-node scripts/decisions/g3-threshold-candidates.ts",
    "tables:g3": "ts-node scripts/decisions/g3-insertion-tables.ts",
    "host-batch:g3": "ts-node scripts/decisions/g3-host-answer-batch.ts",
    "validate-host:g3": "ts-node scripts/decisions/g3-validate-host-answers.ts",
    "freeze-gaps:g3": "ts-node scripts/decisions/g3-freeze-gap-packet.ts",
    "approval:g3": "ts-node scripts/decisions/g3-approval-request.ts",
    "validate-approval:g3": "ts-node scripts/decisions/g3-validate-approval.ts",
    "vercel-gateway:g3": "ts-node scripts/decisions/g3-vercel-gateway-report.ts",
    "memo:g3": "ts-node scripts/decisions/g3-decision-memo.ts",
    "implementation-map:g3": "ts-node scripts/decisions/g3-implementation-map.ts",
    "analysis-report:g3": "ts-node scripts/decisions/g3-analysis-report.ts",
    "claude-reconstruction:g3": "ts-node scripts/decisions/g3-claude-reconstruction.ts",
    "closure-input-template:g3": "ts-node scripts/decisions/g3-closure-input-template.ts",
    "element-telemetry:g3": "ts-node scripts/decisions/g3-element-telemetry-readiness.ts",
    "gate-readiness:g3": "ts-node scripts/decisions/g3-gate-readiness.ts",
    "commercial-recommendations:g3": "ts-node scripts/decisions/g3-commercial-recommendations.ts",
    "learning-architecture:g3": "ts-node scripts/decisions/g3-learning-architecture.ts",
    "completion-audit:g3": "ts-node scripts/decisions/g3-completion-audit.ts",
    "ledger-audit:g3": "ts-node scripts/decisions/g3-ledger-audit.ts",
    "preflight:g3": "ts-node scripts/decisions/g3-closure-preflight.ts",
    "runbook:g3": "ts-node scripts/decisions/g3-runbook.ts",
    "handoff:g3": "ts-node scripts/decisions/g3-handoff.ts"
  },
  "keywords": [
    "openchrome",
    "mcp",
    "mcp-server",
    "browser-automation",
    "parallel-sessions",
    "cdp",
    "chrome",
    "chrome-devtools-protocol",
    "ai-agent",
    "puppeteer"
  ],
  "author": "shaun0927",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaun0927/openchrome.git"
  },
  "bugs": {
    "url": "https://github.com/shaun0927/openchrome/issues"
  },
  "homepage": "https://github.com/shaun0927/openchrome#readme",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^9.0.8",
    "@types/write-file-atomic": "^4.0.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "playwright": "^1.49.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "argon2": "^0.43.0",
    "cheerio": "1.0.0-rc.12",
    "commander": "^12.0.0",
    "jose": "^5.10.0",
    "proper-lockfile": "^4.1.2",
    "puppeteer-core": "npm:rebrowser-puppeteer-core@23.10.3",
    "turndown": "^7.2.4",
    "uuid": "^9.0.0",
    "write-file-atomic": "^5.0.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "basic-ftp": "^5.3.1",
    "ip-address": "^10.1.1"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "dist",
    "config",
    "README.md",
    "docs/agent/capability-map.md",
    "LICENSE"
  ]
}
